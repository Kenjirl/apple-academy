---
import { type Project } from '../lib/site';

interface Props {
  project: Project;
}

const d = Astro.props.project.data;
const rows: { label: string; value: string; links?: typeof d.links; datetime?: string }[] = [
  { label: 'Phase', value: d.phase },
  { label: 'Period', value: d.period, datetime: d.date },
  { label: 'Team', value: d.team },
  { label: 'My role', value: d.role },
  ...(d.platform ? [{ label: 'Platform', value: d.platform }] : []),
  ...(d.links.length ? [{ label: 'Code', value: '', links: d.links }] : []),
];
---
<dl class="grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
  {
    rows.map((r) => (
      <div class:list={['border-t border-line pt-3', r.label === 'My role' && 'sm:col-span-2']}>
        <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-faint">{r.label}</dt>
        <dd class="mt-1 leading-relaxed text-ink">
          {r.links ? (
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {r.links.map((l) => (
                <li>
                  {l.private || !l.url ? (
                    <span class="inline-flex items-center gap-1.5 text-muted">
                      <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd" /></svg>
                      {l.label} (private)
                    </span>
                  ) : (
                    <a href={l.url} class="font-medium text-accent-ink underline decoration-1 underline-offset-[3px]">
                      {l.label} ↗
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : r.datetime ? (
            <time datetime={r.datetime}>{r.value}</time>
          ) : (
            r.value
          )}
        </dd>
      </div>
    ))
  }
</dl>
