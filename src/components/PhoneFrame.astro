---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  orientation?: 'portrait' | 'landscape';
  /** Responsive sizes hint, e.g. "(min-width: 1024px) 240px, 45vw". */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  orientation = 'portrait',
  sizes = orientation === 'portrait' ? '(min-width: 1024px) 260px, 60vw' : '(min-width: 1024px) 560px, 90vw',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

// Radii and bezel scale with the frame width: the outer div is the size
// container, the inner body uses cqw units against it.
const landscape = orientation === 'landscape';
---
<div class:list={['phone-frame', className]}>
<div
  class:list={[
    'phone-frame__body relative bg-bezel shadow-[0_1px_0_rgb(255_255_255/0.06)_inset,0_18px_40px_-18px_rgb(0_0_0/0.45)]',
    landscape ? 'phone-frame--landscape' : 'phone-frame--portrait',
  ]}
>
  <Picture
    src={src}
    alt={alt}
    widths={landscape ? [560, 900, 1400] : [300, 414, 828]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    loading={loading}
    decoding="async"
    pictureAttributes={{ class: 'block' }}
    class="block h-auto w-full bg-surface-2"
  />
</div>
</div>

<style>
  .phone-frame {
    container-type: inline-size;
  }
  .phone-frame--portrait {
    padding: 2.6cqw;
    border-radius: 14cqw;
  }
  .phone-frame--portrait :global(img) {
    border-radius: 11.5cqw;
  }
  .phone-frame--landscape {
    padding: 1.3cqw;
    border-radius: 6.5cqw;
  }
  .phone-frame--landscape :global(img) {
    border-radius: 5.3cqw;
  }
</style>
