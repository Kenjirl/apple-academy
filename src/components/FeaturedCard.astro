---
import AppIcon from './AppIcon.astro';
import PhoneFrame from './PhoneFrame.astro';
import StackList from './StackList.astro';
import { accentStyle, projectUrl, type Project } from '../lib/site';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const d = project.data;
const landscape = d.orientation === 'landscape';
const shots = d.screenshots.slice(0, landscape ? 2 : 3);
const href = projectUrl(project);
---
<article
  class="accent-scope group relative flex flex-col overflow-hidden rounded-[28px] border border-line bg-surface"
  style={accentStyle(project)}
>
  <!-- Screenshot stage, tinted with the app's own color. Phones are cropped by the card. -->
  <div
    class="relative h-72 overflow-hidden sm:h-[22rem]"
    style="background: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--accent) 34%, transparent), color-mix(in srgb, var(--accent) 8%, transparent) 70%);"
  >
    {
      landscape ? (
        <div class="absolute inset-x-0 top-8 mx-auto h-full w-[88%] max-w-[560px]">
          {shots[1] && (
            <PhoneFrame
              src={shots[1].src}
              alt={shots[1].alt}
              orientation="landscape"
              sizes="(min-width: 1024px) 420px, 75vw"
              loading={eager ? 'eager' : 'lazy'}
              class="absolute right-0 top-0 w-[76%] rotate-[3deg] transition-transform duration-500 group-hover:rotate-[4deg] motion-reduce:transition-none"
            />
          )}
          <PhoneFrame
            src={shots[0].src}
            alt={shots[0].alt}
            orientation="landscape"
            sizes="(min-width: 1024px) 420px, 75vw"
            loading={eager ? 'eager' : 'lazy'}
            class="absolute left-0 top-[34%] w-[76%] -rotate-[2deg] transition-transform duration-500 group-hover:-rotate-[3deg] motion-reduce:transition-none"
          />
        </div>
      ) : (
        <div class="absolute inset-x-0 top-8 mx-auto flex w-[92%] max-w-[460px] items-start justify-center">
          {shots.map((s, i) => (
            <PhoneFrame
              src={s.src}
              alt={s.alt}
              sizes="(min-width: 1024px) 170px, 34vw"
              loading={eager ? 'eager' : 'lazy'}
              class:list={[
                'w-[37%] transition-transform duration-500 motion-reduce:transition-none',
                i === 0 && 'z-0 -mr-[5%] mt-[9%] -rotate-[5deg] group-hover:-rotate-[7deg]',
                i === 1 && 'z-10',
                i === 2 && 'z-0 -ml-[5%] mt-[9%] rotate-[5deg] group-hover:rotate-[7deg]',
              ]}
            />
          ))}
        </div>
      )
    }
  </div>

  <div class="relative z-20 flex flex-1 flex-col gap-4 border-t border-line bg-surface p-6 sm:p-7">
    <div class="flex items-center gap-4">
      <AppIcon src={d.icon} title={d.title} size={56} loading={eager ? 'eager' : 'lazy'} />
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-ink">{d.phase.replace('Apple Developer Academy · ', '')} · {d.period}</p>
        <h3 class="font-display text-2xl font-bold tracking-tight">
          <a href={href} class="after:absolute after:inset-0 after:z-30 after:content-[''] focus-visible:outline-none group-has-[a:focus-visible]:underline">
            {d.title}
          </a>
        </h3>
      </div>
    </div>
    <p class="text-[1.05rem] leading-relaxed text-ink">{d.tagline}</p>
    <p class="text-sm leading-relaxed text-muted">
      <span class="font-semibold text-ink">{d.team}.</span> {d.role}
    </p>
    <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-2">
      <StackList items={d.stack} max={6} />
      <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink" aria-hidden="true">
        Read case study
        <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
      </span>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-0 rounded-[28px] ring-0 ring-accent/0 transition-[box-shadow] group-hover:ring-2 group-hover:ring-[color-mix(in_srgb,var(--accent)_55%,transparent)] group-has-[a:focus-visible]:ring-2 group-has-[a:focus-visible]:ring-[var(--focus)]"></div>
</article>
