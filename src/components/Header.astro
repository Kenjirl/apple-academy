---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_NAME, getProfile, withBase } from '../lib/site';

const profile = await getProfile();
const home = withBase();
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="group flex min-w-0 items-center gap-2.5 whitespace-nowrap font-semibold tracking-tight">
      <span class="inline-flex size-8 items-center justify-center rounded-[10px] bg-ink text-sm font-bold text-bg" aria-hidden="true">
        {profile.name.charAt(0)}
      </span>
      <span>{SITE_NAME}</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm sm:gap-2">
      <a href={`${home}#projects`} class="hidden rounded-full px-3 py-2 text-muted transition-colors hover:text-ink sm:inline-flex">Projects</a>
      <a href={`${home}#about`} class="hidden rounded-full px-3 py-2 text-muted transition-colors hover:text-ink sm:inline-flex">About</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
