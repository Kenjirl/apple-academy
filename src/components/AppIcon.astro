---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  title: string;
  /** Rendered size in CSS px. */
  size?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, title, size = 56, loading = 'lazy', class: className = '' } = Astro.props;
---
{
  src ? (
    <Image
      src={src}
      alt=""
      width={size}
      height={size}
      densities={[1, 2, 3]}
      format="webp"
      loading={loading}
      class:list={['app-icon shrink-0 shadow-sm ring-1 ring-black/5 dark:ring-white/10', className]}
      style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.225)}px`}
    />
  ) : (
    <span
      aria-hidden="true"
      class:list={['inline-flex shrink-0 items-center justify-center bg-accent-ink font-bold text-bg', className]}
      style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.225)}px;font-size:${Math.round(size * 0.42)}px`}
    >
      {title.charAt(0)}
    </span>
  )
}
