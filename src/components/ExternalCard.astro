---
import AppIcon from './AppIcon.astro';
import StackList from './StackList.astro';
import { accentStyle, type Project } from '../lib/site';

interface Props {
  project: Project;
  /** Heading level inside the page outline. */
  as?: 'h3' | 'h4';
}

const { project, as: Heading = 'h3' } = Astro.props;
const d = project.data;
const url = d.externalUrl;
---
<article
  class="accent-scope group relative flex flex-col gap-4 rounded-3xl border border-dashed border-line bg-surface p-5 sm:p-6"
  style={accentStyle(project)}
>
  <div class="flex flex-wrap items-start gap-x-4 gap-y-3">
    <AppIcon src={d.icon} title={d.title} size={48} />
    <div class="min-w-[55%] flex-1">
      <Heading class="text-lg font-bold leading-tight tracking-tight">
        {url ? <a href={url} class="after:absolute after:inset-0 after:content-['']">{d.title}</a> : d.title}
      </Heading>
      <p class="text-xs text-muted">{d.phase.replace('Apple Developer Academy · ', '')} · {d.period} · {d.team}</p>
    </div>
    <span
      class:list={[
        'order-last shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold sm:order-none',
        url ? 'bg-accent-ink text-bg' : 'border border-line text-muted',
      ]}
    >
      {url ? 'Visit site ↗' : d.externalNote ?? 'Coming soon'}
    </span>
  </div>
  <p class="text-sm leading-relaxed text-ink">{d.tagline}</p>
  <p class="text-sm leading-relaxed text-muted">{d.role}</p>
  <StackList items={d.stack} />
</article>
