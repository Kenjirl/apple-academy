---
import { getProfile } from '../lib/site';

const profile = await getProfile();
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {year} {profile.name} · Built with Astro, hosted on GitHub Pages.</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a class="hover:text-ink" href={profile.github} rel="me">GitHub</a></li>
      {profile.email && <li><a class="hover:text-ink" href={`mailto:${profile.email}`}>Email</a></li>}
      {profile.mainSite && <li><a class="hover:text-ink" href={profile.mainSite}>Main portfolio</a></li>}
    </ul>
  </div>
</footer>
