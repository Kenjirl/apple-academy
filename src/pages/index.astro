---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExternalCard from '../components/ExternalCard.astro';
import { accentStyle, getProfile, getProjects, isSolo, projectUrl, toolbox } from '../lib/site';

const profile = await getProfile();
const { caseStudies, featured, more, external, all } = await getProjects();
const groups = toolbox(all);
const solo = caseStudies.filter(isSolo).length;
const withBackend = caseStudies.filter((p) => p.data.kind === 'ios-app+backend').length;
---
<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <p class="text-sm font-semibold text-muted">{profile.headline}</p>
    <h1 class="mt-3 max-w-3xl font-display text-[2.6rem] font-bold leading-[1.05] tracking-[-0.03em] sm:text-6xl">
      Hi, I’m {profile.name}.<br />
      <span class="text-muted">Here’s what I built this year.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{profile.intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#projects" class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-bg hover:opacity-90">
        See the projects
      </a>
      <a href={profile.github} rel="me" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-semibold hover:border-faint">
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        GitHub
      </a>
      {
        profile.email && (
          <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-semibold hover:border-faint">
            Email me
          </a>
        )
      }
    </div>

    <!-- Every app icon, in reading order -->
    <ul class="mt-14 flex flex-wrap items-center gap-3 sm:gap-4" aria-label="Apps on this site">
      {
        caseStudies.map((p, i) => (
          <li class="accent-scope" style={accentStyle(p)}>
            <a href={projectUrl(p)} class="block rounded-[14px] transition-transform hover:-translate-y-1 motion-reduce:transition-none" aria-label={p.data.title} title={p.data.title}>
              <AppIcon src={p.data.icon} title={p.data.title} size={56} loading={i < 4 ? 'eager' : 'lazy'} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-sm text-muted">
      {caseStudies.length} apps · {solo} solo, {caseStudies.length - solo} in teams · {withBackend} with a backend I wrote
    </p>
  </section>

  <!-- Featured -->
  <section id="projects" class="mx-auto max-w-6xl scroll-mt-20 px-4 sm:px-6" aria-labelledby="featured-title">
    <h2 id="featured-title" class="mb-6 font-display text-2xl font-bold tracking-tight sm:text-3xl">Featured</h2>
    <div class="grid gap-6 lg:grid-cols-2">
      {featured.map((p, i) => <FeaturedCard project={p} eager={i === 0} />)}
    </div>
  </section>

  <!-- More projects -->
  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="more-title">
    <div class="mb-6">
      <h2 id="more-title" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">More projects</h2>
      <p class="mt-1 text-muted">Newest first.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- Other work -->
  {
    external.length > 0 && (
      <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="other-title">
        <div class="mb-6">
          <h2 id="other-title" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Other work</h2>
          <p class="mt-1 text-muted">Team projects that will get their own sites.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          {external.map((p) => <ExternalCard project={p} />)}
        </div>
      </section>
    )
  }

  <!-- Toolbox -->
  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-labelledby="toolbox-title">
    <h2 id="toolbox-title" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Toolbox</h2>
    <p class="mt-1 text-muted">Everything used across these projects.</p>
    <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-5">
      {
        groups.map((g) => (
          <div class="border-t border-line pt-4">
            <h3 class="text-xs font-semibold uppercase tracking-[0.08em] text-muted">{g.name}</h3>
            <ul class="mt-3 space-y-1.5 text-sm">
              {g.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- About & contact -->
  <section id="about" class="mx-auto mt-20 max-w-6xl scroll-mt-20 px-4 sm:px-6" aria-labelledby="about-title">
    <div class="grid gap-8 rounded-[28px] border border-line bg-surface p-6 sm:p-10 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 id="about-title" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">About</h2>
        <div class="mt-4 space-y-4 leading-relaxed text-muted">
          <p>
            I’m {profile.name}, a learner at Apple Developer Academy in 2026. Every project here was built during the
            program — in short weekly assignments, longer team challenges, and on my own on the side.
          </p>
          <p>
            Most of them are iOS apps in SwiftUI. Where an app needed a server, I wrote that too: a FastAPI service
            with vector search for Snoop, and a WebSocket + push backend for News Portal. Each case study says
            honestly what I built, what the team built, and what still doesn’t work.
          </p>
        </div>
      </div>
      <div class="flex min-w-0 flex-col justify-center gap-3 md:border-l md:border-line md:pl-8">
        <p class="text-sm font-semibold">Get in touch</p>
        {profile.email && <a href={`mailto:${profile.email}`} class="break-all text-lg font-semibold underline decoration-1 underline-offset-4">{profile.email}</a>}
        <a href={profile.github} rel="me" class="text-muted underline decoration-1 underline-offset-4 hover:text-ink">github.com/Kenjirl</a>
        {profile.mainSite && <a href={profile.mainSite} class="text-muted underline decoration-1 underline-offset-4 hover:text-ink">Main portfolio ↗</a>}
      </div>
    </div>
  </section>
</Base>
